
package com.neuralnetworth;
unit PropertyRules;

import org.drools.ruleunits.api.RuleUnitData;
import org.drools.ruleunits.api.DataStream;
import com.neuralnetworth.Property;
import com.neuralnetworth.Location;
import com.neuralnetworth.PropertyFact;

rule "Low crime rate"
when
    $location: Location(crimeRate == "low")
    $property: Property(location == $location)
then
    insert(new PropertyFact("crimeRate", $property, "low"));
end

query "FindBestProperties"
    $propertyFact: PropertyFact(attribute == "crimeRate", value == "low")
end
