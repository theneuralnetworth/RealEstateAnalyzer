package com.neuralnetworth;

import com.neuralnetworth.Model.Location;
import com.neuralnetworth.Model.Property;

// Rule 1.1: If the crime rate in a location is low and the property is located there, then update the property to have a low crime rate.
rule "Security Rule 1.1 - Low Crime Rate ; Property has a 'Low' crime rate because is in a location with a 'Low' crime rate"

    when
        $location : Location(crimeRate == "low")
        $property : Property(location == $location)
    then
        $property.setCrimeRate("low");
        update($property);
end

// Rule 1.2: If the crime rate in a location is medium and the property is located there, then update the property to have a medium crime rate.
rule "Security Rule 1.2 - Medium Crime Rate ; Property has a 'Medium' crime rate because is in a location with a 'Medium' crime rate"

    when
        $location : Location(crimeRate == "medium")
        $property : Property(location == $location)
    then
        $property.setCrimeRate("medium");
        update($property);
end

// Rule 1.3: If the crime rate in a location is high and the property is located there, then update the property to have a high crime rate.
rule "Security Rule 1.3 - High Crime Rate ; Property has a 'High' crime rate because is in a location with a 'High' crime rate"

    when
        $location : Location(crimeRate == "high")
        $property : Property(location == $location)
    then
        $property.setCrimeRate("high");
        update($property);
end

// Rule 1.4: If the property has a low crime rate and a security system is present, then update the property to have high security.
rule "Security Rule 1.4 - High Security ; Property's crime rate is 'Low' and have a security system"

    when
        $property : Property(crimeRate == "low", securitySystem == "present")
    then
        $property.setSecurity("high");
        update($property);
end

rule "Security Rule 1.5 - Low Security ; Property's crime rate is 'High' and doesn't have security system"

    when
        $property : Property(crimeRate == "high", securitySystem == "absent")
    then
        $property.setSecurity("low");
        update($property);
    end

rule "Security Rule 1.6 - Medium Security ; Doesn't have a security system, but the property's crime rate is either 'Low' or 'Medium'"

    when
        $property : Property(securitySystem == "absent",
                             (crimeRate == "low" || crimeRate == "medium"))
    then
        $property.setSecurity("medium");
        update($property);
    end

rule "Security Rule 1.7 - Medium Security ; Property has a 'High' level of crime, but has a security system"

    when
        $property : Property(crimeRate == "high", securitySystem == "present")
    then
        $property.setSecurity("medium");
        update($property);
    end

rule "Security Rule 1.71 - Medium Security ; Property has a 'Medium' level of crime and has a security system"

    when
        $property : Property(crimeRate == "medium", securitySystem == "present")
    then
        $property.setSecurity("medium");
        update($property);
    end


// Rule 2.1: If the property is located in an area with an airport and busy traffic, then the property will have a high noise level.
rule "Noise Rule 2.1 - High Noise Level ; Has an airport nearby and is in a location with busy traffic"
    when
        $location : Location(airport == "present", busyTraffic == "present")
        $property : Property(location == $location)
    then
        $property.setNoiseLevel("high");
        update($property);
end

// Rule 2.2: If the property is located in an area with an airport or busy traffic, then the property will have a medium noise level.
rule "Noise Rule 2.2 - Medium Noise Level ; Either has an airport nearby or is in a location with busy traffic"
    when
        $location : Location((airport == "present" && busyTraffic == "absent") || (airport == "absent" && busyTraffic == "present"))
        $property : Property(location == $location)
    then
        $property.setNoiseLevel("medium");
        update($property);
end

// Rule 2.3: If the property is not located in an area with an airport and does not have busy traffic, then the property will have a low noise level.
rule "Noise Rule 2.3 - Low Noise Level  ; Doesn't have an airport nearby and it's not in a location with busy traffic"
    when
        $location : Location(airport == "absent", busyTraffic == "absent")
        $property : Property(location == $location)
    then
        $property.setNoiseLevel("low");
        update($property);
end

// Rule 2.4: If the property has a high noise level and low acoustic insulation, then the property will have low sound comfort.
rule "Comfort Rule 2.4 - Low Sound Comfort ; Has 'High' level of noise and 'Low' acoustic insulation level"
    when
        $property : Property(noiseLevel == "high", acousticInsulation == "low")
    then
        $property.setSoundComfort("low");
        update($property);
end

// Rule 2.5: If the property has high acoustic insulation and a low noise level, then the property will have high sound comfort.
rule "Comfort Rule 2.5 - High Sound Comfort ; Has 'High' level of acoustic insulation and 'Low' noise level"
    when
        $property : Property(acousticInsulation == "high", noiseLevel == "low")
    then
        $property.setSoundComfort("high");
        update($property);
end

// Rule 2.6: If the property has high acoustic insulation and a high noise level, then the property will have medium sound comfort.
rule "Comfort Rule 2.6 - Medium Sound Comfort ; Has 'High' level because of both acoustic insulation and noise leve being 'High'"
    when
        $property : Property(acousticInsulation == "high", noiseLevel == "high")
    then
        $property.setSoundComfort("medium");
        update($property);
end

// Rule 2.7: If the property has medium acoustic insulation or a medium noise level, then the property will have medium sound comfort.
rule "Comfort Rule 2.7 - Medium Sound Comfort ; Has 'Medium' level because of both acoustic insulation and noise level being 'Medium'"
    when
        $property : Property(acousticInsulation == "medium" && noiseLevel == "medium")
    then
        $property.setSoundComfort("medium");
        update($property);
end

// Rule 2.71: If the property has medium acoustic insulation or a medium noise level, then the property will have medium sound comfort.
rule "Comfort Rule 2.71 - Medium Sound Comfort ; Has 'Medium' level because of both acoustic insulation and noise level being 'Low'"
    when
        $property : Property(acousticInsulation == "low" && noiseLevel == "low")
    then
        $property.setSoundComfort("medium");
        update($property);
end

// Rule 2.72: If the property has medium acoustic insulation or a medium noise level, then the property will have medium sound comfort.
rule "Comfort Rule 2.72 - Medium Sound Comfort ; Has 'Medium' level because has a 'High' level of acoustic insulation and a noise level of 'Medium'"
    when
        $property : Property(acousticInsulation == "high" && noiseLevel == "medium")
    then
        $property.setSoundComfort("medium");
        update($property);
end
// Rule 2.73: If the property has medium acoustic insulation or a medium noise level, then the property will have medium sound comfort.
rule "Comfort Rule 2.73 - Medium Sound Comfort ; Has 'Medium' level because has a 'Low' level of acoustic insulation and a noise level of 'Medium'"
    when
        $property : Property(acousticInsulation == "low" && noiseLevel == "medium")
    then
        $property.setSoundComfort("medium");
        update($property);
end

// Rule 2.8: If the property has high sound comfort and high thermal comfort, then the property will have high overall comfort.
rule "Comfort Rule 2.8 - High Overall Comfort ; Both sound and thermal comfort's level is 'High'"
    when
        $property : Property(soundComfort == "high", thermalComfort == "high")
    then
        $property.setOverallComfort("high");
        update($property);
end

// Rule 2.9: If the property has low sound comfort and low thermal comfort, then the property will have low overall comfort.
rule "Comfort Rule 2.9 - Low Overall Comfort ; Both sound and thermal comfort's level is 'Low'"
    when
        $property : Property(soundComfort == "low", thermalComfort == "low")
    then
        $property.setOverallComfort("low");
        update($property);
end

// Rule 2.10: If the property has high sound comfort and low thermal comfort, then the property will have medium overall comfort.
rule "Comfort Rule 2.10 - Medium Overall Comfort ; Sound comfort is 'High' level and thermal comfort is 'Low'' level"
    when
            $property : Property(soundComfort == "high", thermalComfort == "low")
    then
        $property.setOverallComfort("medium");
        update($property);
end

// Rule 2.11: If the property has low sound comfort and high thermal comfort, then the property will have medium overall comfort.
rule "Comfort Rule 2.11 - Medium Overall Comfort ; Sound confort level is 'Low' and thermal comfort level is 'High' "
    when
        $property : Property(soundComfort == "low", thermalComfort == "high")
    then
        $property.setOverallComfort("medium");
        update($property);
end

// Rule 2.12: If the property has medium sound comfort or medium thermal comfort, then the property will have medium overall comfort.
rule "Comfort Rule 2.12 - Medium Overall Comfort ; Sound and thermal comfort are 'Medium' level"
    when
        $property : Property(soundComfort == "medium" || thermalComfort == "medium")
    then
        $property.setOverallComfort("medium");
        update($property);
end

// Rule 3.1: If the property has an elevator and ramps, then the property is classified as having high accessibility.
rule "Accessibility Rule 3.1 - High Accessibility ; Has elevator and ramps"
    when
        $property : Property(elevator == "present", ramps == "present")
    then
        $property.setAccessibility("high");
        update($property);
end

// Rule 3.2: If the property does not have an elevator and ramps, then the property is classified as having low accessibility.
rule "Accessibility Rule 3.2 - Low Accessibility ; Doesn't have elevator nor ramps"
    when
        $property : Property(elevator == "absent", ramps == "absent")
    then
        $property.setAccessibility("low");
        update($property);
end

// Rule 3.3: If the property has either an elevator or ramps, but not both, then the property is classified as having medium accessibility.
rule "Accessibility Rule 3.3 - Medium Accessibility ; Has either elevator or ramps"
    when
        $property : Property(
            (elevator == "present" && ramps == "absent") ||
            (elevator == "absent" && ramps == "present")
        )
    then
        $property.setAccessibility("medium");
        update($property);
end

// Rule 4.1: If the property has either a swimming pool or a garden, but not both, then the property is classified as having medium amenities.
rule "Amenities Rule 4.1 - Medium Amenities ; Has either swimming pool or garden"
    when
        $property : Property(
            (swimmingPool == "present" && garden == "absent") ||
            (swimmingPool == "absent" && garden == "present")
        )
    then
        $property.setAmenities("medium");
        update($property);
end

// Rule 4.2: If the property has both a swimming pool and a garden, then the property is classified as having high amenities.
rule "Amenities Rule 4.2 - High Amenities ; Has swimming pool and garden"
    when
        $property : Property(swimmingPool == "present", garden == "present")
    then
        $property.setAmenities("high");
        update($property);
end

// Rule 4.3: If the property has neither a swimming pool nor a garden, then the property is classified as having low amenities.
rule "Amenities Rule 4.3 - Low Amenities ; Doesn't have swimming pool nor garden"
    when
        $property : Property(swimmingPool == "absent", garden == "absent")
    then
        $property.setAmenities("low");
        update($property);
end

// Rule 4.4: If the property is new or has low amenities, then it is classified as requiring low maintenance.
rule "Maintenance Rule 4.4 - Low Maintenance ; 'Low' level of Amenities and Property condition is 'New'"
    when
        $property : Property(propertyCondition == "new" || amenities == "low")
    then
        $property.setMaintenance("low");
        update($property);
end

// Rule 4.5: If the property is not new and has medium amenities, then it is classified as requiring medium maintenance.
rule "Maintenance Rule 4.5 - Medium Maintenance ; 'Medium' level of Amenities and Property condition is 'New'"
    when
        $property : Property(propertyCondition != "new", amenities == "medium")
    then
        $property.setMaintenance("medium");
        update($property);
end

// Rule 4.6: If the property is not new and has high amenities, then it is classified as requiring high maintenance.
rule "Maintenance Rule 4.6 - High Maintenance ; 'High' level of Amenities and Property condition is 'New'"
    when
        $property : Property(propertyCondition != "new", amenities == "high")
    then
        $property.setMaintenance("high");
        update($property);
end

// Rule 5.1: If the property has an energy rating of A++ or A+ or A, then the property is classified as having high energy efficiency.
rule "Energy_Efficiency Rule 5.1 - High Energy Efficiency ; Property's energy rating is either 'A++', 'A+' or 'A'"
    when
        $property : Property(
            energyRating.toLowerCase() == "a_plus_plus" ||
            energyRating.toLowerCase() == "a_plus" ||
            energyRating.toLowerCase() == "a"
        )
    then
        $property.setEnergyEfficiency("high");
        update($property);
end

// Rule 5.2: If the property has an energy rating of B or C, then the property is classified as having medium energy efficiency.
rule "Energy_Efficiency Rule 5.2 - Medium Energy Efficiency ; Property's energy rating is either 'B' or 'C'"
    when
        $property : Property(energyRating.toLowerCase() == "b" || energyRating.toLowerCase() == "c")
    then
        $property.setEnergyEfficiency("medium");
        update($property);
end

// Rule 5.3: If the property has an energy rating of D, E, or F, then the property is classified as having low energy efficiency.
rule "Energy_Efficiency Rule 5.3 - Low Energy Efficiency ; Property's energy rating is either 'D', 'E' or 'F'"
    when
        $property : Property(energyRating.toLowerCase() == "d" || energyRating.toLowerCase() == "e" || energyRating.toLowerCase() == "f")
    then
        $property.setEnergyEfficiency("low");
        update($property);
end

// Rule 6.1: If the property is located near schools, then it is classified as having the service "nearby schools".
rule "Services Rule 6.1 - Nearby Schools ; Property has a school nearby"
when
    $location : Location(nearbySchools == "present")
    $property : Property(location == $location, services not contains "nearby schools")
then
    $property.addService("nearby schools");
    update($property);
end


// Rule 6.2: If the property is located near public transport, then it is classified as having the service "nearby public transport".
rule "Services Rule 6.2 - Nearby Public Transport ; Property has public transports nearby"
    when
        $location : Location(location: nearbyPublicTransport == "present")
        $property : Property(location == $location, services not contains "nearby public transport")
    then
        $property.addService("nearby public transport");
        update($property);
end

// Rule 6.3: If the property is located near hospitals, then it is classified as having the service "nearby hospitals".
rule "Services Rule 6.3 - Nearby Hospitals ; Property has an hospital nearby"
    when
        $location : Location(nearbyHospitals == "present")
        $property : Property(location == $location, services not contains "nearby hospitals")
    then
        $property.addService("nearby hospitals");
        update($property);
end

// Rule 6.4: If the property is located near supermarkets, then it is classified as having the service "nearby supermarkets".
rule "Services Rule 6.4 - Nearby Supermarkets ; Property has supermarkets nearby"
    when
        $location : Location(nearbySupermarkets == "present")
        $property : Property(location == $location, services not contains "nearby supermarkets")
    then
        $property.addService("nearby supermarkets");
        update($property);
end

// Rule 6.5: If the property is located near leisure areas, then it is classified as having the service "nearby leisure areas".
rule "Services Rule 6.5 - Nearby Leisure Areas ; Property has leisure areas nearby"
    when
        $location : Location(nearbyLeisureAreas == "present")
        $property : Property(location == $location, services not contains "nearby leisure areas")
    then
        $property.addService("nearby leisure areas");
        update($property);
end

// Rule 6.7: If a property has four or more nearby services, then it is classified as having a high service level.
rule "Services Rule 6.7 - High Service Level ; Property's service level is 'High' because it has 5 or more services nearby"
    when
        $property : Property(numberOfServices > 4)
    then
        $property.setServiceLevel("high");
        update($property);
end

// Rule 6.8: If a property has two or three nearby services, then it is classified as having a medium service level.
rule "Services Rule 6.8 - Medium Service Level ; Property's service level is 'Medium' because it has between 2 and 4 services nearby"
    when
        $property : Property(numberOfServices >= 2 && numberOfServices <= 4)
    then
        $property.setServiceLevel("medium");
        update($property);
end

// Rule 6.9: If a property has less than two nearby services, then it is classified as having a low service level.
rule "Services Rule 6.9 - Low Service Level ; Property's service level is 'Low' because it has less than 2 services nearby"
    when
        $property : Property(numberOfServices < 2)
    then
        $property.setServiceLevel("low");
        update($property);
end

// Rule 7.1: If the property has optical fiber and smart appliances, then the property is classified as having high connectivity.
rule "Connectivity Rule 7.1 - High Connectivity ; Connectivity level is 'High' because it has optical fiber and smart appliances"
    when
        $property : Property(opticalFiber == "present", smartAppliances == "present")
    then
        $property.setConnectivity("high");
        update($property);
end

// Rule 7.2: If the property has optical fiber and no smart appliances, then the property is classified as having medium connectivity.
rule "Connectivity Rule 7.2 - Medium Connectivity ; Connectivity level is 'Medium' because it has optical fiber but not smart appliances"
    when
        $property : Property(opticalFiber == "present", smartAppliances == "absent")
    then
        $property.setConnectivity("medium");
        update($property);
end

// Rule 7.3: If the property does not have optical fiber but has smart appliances, then the property is classified as having medium connectivity.
rule "Connectivity Rule 7.3 - Medium Connectivity ; Connectivity level is 'Medium' because it has smart appliances but not optical fiber"
    when
        $property : Property(opticalFiber == "absent", smartAppliances == "present")
    then
        $property.setConnectivity("medium");
        update($property);
end

// Rule 7.4: If the property does not have optical fiber or smart appliances, then the property is classified as having low connectivity.
rule "Connectivity Rule 7.4 - Low Connectivity ; Connectivity level is 'Low' because it doesn't have neither optical fiber nor smart appliances"
    when
        $property : Property(opticalFiber == "absent", smartAppliances == "absent")
    then
        $property.setConnectivity("low");
        update($property);
end

// Rule 8.1: If the property is located near a forest or beach, then it is classified as having high view quality.
rule "View_Quality Rule 8.1 - High View Quality ; View quality is 'High' because is near a forest or a beach"
    when
        $location : Location(forest == "present" || beach == "present")
        $property : Property(location == $location)
    then
        $property.setViewQuality("high");
        update($property);
end

// Rule 8.2: If the property is not near a forest or beach, then it is classified as having low view quality.
rule "View_Quality Rule 8.2 - Low View Quality ; View quality is 'Low' because isn't near a forest or a beach"
    when
        $location : Location(forest == "absent", beach == "absent")
        $property : Property(location == $location)
    then
        $property.setViewQuality("low");
        update($property);
end

// Rule 8.3: If the property has high view quality and is a residence, it is classified as high view quality.
rule "View_Quality Rule 8.3 - High View Quality for Residence ; View quality level is 'High' because view quality is 'High' and is a residence"
    when
        $property : Property(viewQuality == "high", propertyType == "residence")
    then
        $property.setViewQualityLevel("high");
        update($property);
end

// Rule 8.4: If the property has low view quality and is a residence, it is classified as medium view quality.
rule "View_Quality Rule 8.4 - Medium View Quality for Residence ; View quality level is 'Medium' because view quality is 'Low' and is a residence"
    when
        $property : Property(viewQuality == "low", propertyType == "residence")
    then
        $property.setViewQualityLevel("medium");
        update($property);
end

// Rule 8.5: If the property has low view quality and is an apartment, it is classified as low view quality.
rule "View_Quality Rule 8.5 - Low View Quality for Apartment ; View quality level is 'Low' because view quality is 'Low' and is an apartment"
    when
        $property : Property(viewQuality == "low", propertyType == "apartment")
    then
        $property.setViewQualityLevel("low");
        update($property);
end

// Rule 8.6: If the property has high view quality and is on the 4th floor or higher, it is classified as high view quality.
rule "View_Quality Rule 8.6 - High View Quality for High Floor ; View quality level is 'High' because view quality is 'High' and is in the 4th floor or higher"
    when
        $property : Property(viewQuality == "high", floorLevel >= 4)
    then
        $property.setViewQualityLevel("high");
        update($property);
end

// Rule 8.7: If the property has high view quality and is on the 2nd or 3rd floor, it is classified as medium view quality.
rule "View_Quality Rule 8.7 - Medium View Quality for Mid Floor ; View quality level is 'Medium' because view quality is 'High' and is between the 2nd and 4th floor"
    when
        $property : Property(viewQuality == "high", floorLevel >= 2 && floorLevel < 4)
    then
        $property.setViewQualityLevel("medium");
        update($property);
end

// Rule 8.8: If the property has high view quality and is on the 1st floor, it is classified as low view quality.
rule "View_Quality Rule 8.8 - Low View Quality for Low Floor ; View quality level is 'Low' because view quality is 'High', but is in the 2nd floor or lower"
    when
        $property : Property(viewQuality == "high", floorLevel < 2)
    then
        $property.setViewQualityLevel("low");
        update($property);
end

// Rule 9.1: If area per room is greater than 30, classify as high spaciousness
rule "Spaciousness Rule 9.1 - High ; Spaciousness level is 'High' because has an area per room higher than 30m2"
when
    $property : Property(areaPerRoom > 30)
then
    $property.setSpaciousness("high");
    update($property);
end

// Rule 9.2: If area per room is between 20 and 30, classify as medium spaciousness
rule "Spaciousness Rule 9.2 - Medium ; Spaciousness level is 'Medium' because has an area per room between 20m2 and 30m2"
when
    $property : Property(areaPerRoom > 20 && areaPerRoom <= 30)
then
    $property.setSpaciousness("medium");
    update($property);
end

// Rule 9.3: If area per room is 20 or less, classify as low spaciousness
rule "Spaciousness Rule 9.3 - Low m2 ; Spaciousness level is 'Low' because has an area per room lower than 20m2"
when
    $property : Property(areaPerRoom <= 20)
then
    $property.setSpaciousness("low");
    update($property);
end

// Rule 10.1: If the sun orientation is south and east, classify as high sun exposure
rule "Sun_Exposure Rule 10.1 - High ; Sun exposure level is 'High' because the property's sun orientation is either south and east"
when
    $property : Property(sunOrientation.contains("south") && sunOrientation.contains("east"))
then
    $property.setSunExposure("high");
    update($property);
end

// Rule 10.2: If the sun orientation is south and not east, classify as high sun exposure
rule "Sun_Exposure Rule 10.2 - Medium ; Sun exposure level is 'Medium' because the property's sun orientation is south and other than east"
when
    $property : Property(sunOrientation.contains("south") && !sunOrientation.contains("east"))
then
    $property.setSunExposure("medium");
    update($property);
end

// Rule 10.21: If the sun orientation is not south and east, classify as high sun exposure
rule "Sun_Exposure Rule 10.21 - Medium ; Sun exposure level is 'Medium' because the property's sun orientation is east and other than south"
when
    $property : Property(!sunOrientation.contains("south") && sunOrientation.contains("east"))
then
    $property.setSunExposure("medium");
    update($property);
end

// Rule 10.3: If the sun orientation is not south and east, classify as high sun exposure
rule "Sun_Exposure Rule 10.21 - Low ; Sun exposure level is 'Low' because the property's sun orientation is north and not south or east"
when
    $property : Property(sunOrientation.contains("north") && !sunOrientation.contains("south") && !sunOrientation.contains("east"))
then
    $property.setSunExposure("low");
    update($property);
end

// Rule 10.4: If the sun orientation is not south and east, classify as high sun exposure
rule "Sun_Exposure Rule 10.4 - Low ; Sun exposure level is 'Low' because the property's sun orientation is west and not south or east"
when
    $property : Property(sunOrientation.contains("west") && !sunOrientation.contains("south") && !sunOrientation.contains("east"))
then
    $property.setSunExposure("low");
    update($property);
end

// Rule 11.1: If public parking availability is low, classify property as low public parking
rule "Parking Rule 11.1 - Low Public Parking ; Public parking level is 'Low' because there's not many parking spots nearby"
when
    $location : Location(parking == "low")
    $property : Property(location == $location)
then
    $property.setPublicParking("low");
    update($property);
end

// Rule 11.2: If public parking availability is medium, classify property as medium public parking
rule "Parking Rule 11.2 - Medium Public Parking ; Public parking level is 'Medium' because there's a decent amount of parking spots nearby"
when
    $location : Location(parking == "medium")
    $property : Property(location == $location)
then
    $property.setPublicParking("medium");
    update($property);
end

// Rule 11.3: If public parking availability is high, classify property as high public parking
rule "Parking Rule 11.3 - High Public Parking ; Public parking level is 'Low' because there's alot of parking spots nearby"
when
    $location : Location(parking == "high")
    $property : Property(location == $location)
then
    $property.setPublicParking("high");
    update($property);
end

// Rule 11.4: If the property has a garage and public parking is high or medium, classify as high overall parking
rule "Parking Rule 11.4 - High Overall Parking ; Overall parking level is 'High' because there's parking spots nearby and has a garage"
when
    $property : Property(garage == "present", (publicParking == "high" || publicParking == "medium"))
then
    $property.setOverallParking("high");
    update($property);
end

// Rule 11.41: If the property has a garage and public parking is high or medium, classify as high overall parking
rule "Parking Rule 11.41 - High Overall Parking ; Overall parking level is 'Medium' because there's just some parking spots nearby and has a garage"
when
    $property : Property(garage == "present", (publicParking == "low"))
then
    $property.setOverallParking("medium");
    update($property);
end

// Rule 11.5: If the property does not have a garage but public parking is high or medium, classify as medium overall parking
rule "Parking Rule 11.5 - Medium Overall Parking ; Overall parking level is 'Medium' because there's parking spots nearby, but hasn't a garage"
when
    $property : Property(garage == "absent", (publicParking == "high" || publicParking == "medium"))
then
    $property.setOverallParking("medium");
    update($property);
end

// Rule 11.6: If the property does not have a garage and public parking is low, classify as low overall parking
rule "Parking Rule 11.6 - Low Overall Parking ; Overall parking level is 'Low' because there's not many parking spots nearby and doesn't have a garage"
when
    $property : Property(garage == "absent", publicParking == "low")
then
    $property.setOverallParking("low");
    update($property);
end

// Rule 12.1: If the property was constructed after 2020, classify as high state of condition
rule "State Rule 12.1 - High ; Build state is 'High' because the property was built after 2020"
when
    $property : Property(yearConstruction > 2020)
then
    $property.setBuildState("high");
    update($property);
end

// Rule 12.2: If the property was constructed between 1990 and 2020 (inclusive), classify as medium state of condition
rule "State Rule 12.2 - Medium ; Build state is 'Medium' because the property was built between 1990 and 2020"
when
    $property : Property(yearConstruction >= 1990 && yearConstruction <= 2020)
then
    $property.setBuildState("medium");
    update($property);
end

// Rule 12.3: If the property was constructed before 1990, classify as low state of condition
rule "State Rule 12.3 - Low ; Build state is 'Low' because the property was built before 1990"
when
    $property : Property(yearConstruction < 1990)
then
    $property.setBuildState("low");
    update($property);
end

// Rule 13.1: If the property is located in an area where property values have increased by more than 50% in the last five years, classify as high potential for appreciation
rule "Potential_Appreciation Rule 13.1 - High Potential ; Property's potential appreciation is 'High' because it's value as increased by more than 50% in the last 5 years"
when
    $location : Location(last5YearsIncreased > 50)
    $property : Property(location == $location)
then
    $property.setPotentialAppreciation("high");
    update($property);
end

// Rule 13.2: If the property is located in an area where property values have increased by between 20% and 50% in the last five years, classify as medium potential for appreciation
rule "Potential_Appreciation Rule 13.2 - Medium Potential ; Property's potential appreciation is 'Medium' because it's value as increased by 20-50% in the last 5 years"
when
    $location : Location(last5YearsIncreased >= 20 && last5YearsIncreased <= 50)
    $property : Property(location == $location)
then
    $property.setPotentialAppreciation("medium");
    update($property);
end

// Rule 13.3: If the property is located in an area where property values have increased by less than 20% in the last five years, classify as low potential for appreciation
rule "Potential_Appreciation Rule 13.3 - Low Potential ; Property's potential appreciation is 'Low' because it's value as increased by less than 220% in the last 5 years"
when
    $location : Location(last5YearsIncreased < 20)
    $property : Property(location == $location)
then
    $property.setPotentialAppreciation("low");
    update($property);
end

// Rule 14.1: If the property has a security value then calculate its score
rule "SecurityScore Rule 14.1 - Calculate security score"
@Weight(0.1)
    no-loop true
when
    $property : Property(security != null)
then
    $property.setScoreSecurity(($property.getMetaScore($property.getSecurity()) * $property.getWeight("security")) * $property.getPrefSecurity());
    update($property);
end

