// Rule 14.14: Calculate total score
rule "TotalScore Rule 14.14 - Calculate total score"
    no-loop true
when
    $property: Property(scoreAccessibility != null && scoreViewQuality != null && scoreSunExposure != null && scoreSpaciousness != null && scoreServices != null
     && scoreSecurity != null && scorePotentialAppreciation != null && scoreParking != null && scoreMaintenance != null && scoreEnergyEfficiency != null &&
     scoreConnectivity != null && scoreBuildState != null && scoreComfort != null && totalScore == -1)
then
    $property.calculateTotalScore();
    update($property);
end